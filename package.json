{
  "name": "sandia-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "verify:lint": "node scripts/verify-lint-rules.mjs",
    "test:unit": "mocha \"tests/unit/**/*.spec.ts\"",
    "test:uat:unit": "mocha \"private/tests/unit/**/*.spec.ts\"",
    "test:android": "wdio run wdio.android.conf.ts",
    "test:ios": "wdio run wdio.ios.conf.ts",
    "test:uat": "node --env-file=private/.env node_modules/@wdio/cli/bin/wdio.js run wdio.android.conf.ts",
    "fetch:demo-app": "node scripts/fetch-demo-app.mjs",
    "test:stability": "wdio run wdio.android.conf.ts --suite demo --repeat 3",
    "doctor": "node scripts/doctor.mjs",
    "error:share": "node scripts/error-share.mjs",
    "guard": "node scripts/guard.mjs",
    "prepare": "simple-git-hooks && node scripts/setup-private-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@wdio/allure-reporter": "10.1.0",
    "@wdio/appium-service": "10.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-wdio": "10.1.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "mocha": "12.0.3",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "webdriverio": "10.1.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run typecheck",
    "pre-push": "npm run guard"
  },
  "lint-staged": {
    "*.{ts,mjs}": "eslint --max-warnings=0"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}
